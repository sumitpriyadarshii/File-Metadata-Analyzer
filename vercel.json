{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/", "destination": "/landing.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
